+            ) : (
+              /* Guest Navigation */
+              <div className="flex items-center space-x-4">
+                <Link
+                  to="/login"
+                  className="text-secondary-600 hover:text-secondary-900 font-medium transition-colors"
+                >
+                  Login
+                </Link>
+                <Link
+                  to="/register"
+                  className="btn btn-primary btn-sm"
+                >
+                  Get Started
+                </Link>
