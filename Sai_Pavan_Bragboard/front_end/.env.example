# Frontend Environment Variables
# Copy this file to .env and update the values

# API Configuration
# Backend FastAPI dev server default is 8000; change if you run on a different port/host.
VITE_API_URL=http://127.0.0.1:8000

# Development Settings
VITE_DEBUG=true

# When true you can enable permissive CORS on backend by setting DEV_ALLOW_ALL_CORS=true in backend .env
# (This flag itself is just informational for the frontend build.)
# VITE_ALLOW_ALL_CORS_HINT=true

# Application Settings
VITE_APP_NAME=BragBoard
VITE_APP_VERSION=1.0.0