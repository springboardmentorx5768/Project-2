# Backend Environment Variables
# Copy this file to .env and update the values

# Database Configuration
# Use SQLite for quick local dev or switch to PostgreSQL for production.
# Example PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/bragboard
DATABASE_URL=sqlite:///./dev.db

# Security
# Generate a long random string for production (e.g. openssl rand -hex 32)
SECRET_KEY=change_me_dev_only

# CORS Settings (Frontend URLs)
# If you need to allow all for quick experimentation set DEV_ALLOW_ALL_CORS=true instead.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
DEV_ALLOW_ALL_CORS=false

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIRECTORY=uploads

# Development Settings
DEBUG=true

# Optional bootstrap admin email (first user with this email becomes admin)
MAIN_ADMIN_EMAIL=admin@example.com